{
  "name": "eventbus-z",
  "version": "2.4.0",
  "description": "Minimal, synchronous, framework-agnostic EventBus and EventEmitter alternative for UI signaling, micro-frontends, and TypeScript projects",
  "license": "MIT",
  "author": "Delpi.Kye",
  "sideEffects": false,

  "type": "module",

  "main": "./build/index.cjs.js",
  "module": "./build/index.esm.js",
  "types": "./build/index.d.ts",

  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.esm.js",
      "require": "./build/index.cjs.js"
    }
  },

  "files": [
    "build"
  ],
  "scripts": {
    "clean": "rimraf build",
    "build": "rollup -c",
    "prepublishOnly": "npm run clean && npm run build"
  },

  "repository": {
    "type": "git",
    "url": "https://github.com/delpikye-v/eventbus.git"
  },
  "homepage": "https://github.com/delpikye-v/eventbus#readme",
  "bugs": {
    "url": "https://github.com/delpikye-v/eventbus/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/delpikye-v"
  },

  "keywords": [
    "eventbus",
    "event-bus",
    "event-emitter",
    "event emitter alternative",
    "pubsub",
    "pub-sub",
    "signal",
    "notification",
    "synchronous",
    "sync event bus",
    "lightweight",
    "minimal",
    "typescript",
    "typed event bus",
    "micro-frontend",
    "iframe",
    "cross-window",
    "frontend infrastructure",
    "ui signaling"
  ],

  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "rimraf": "^5.0.5",
    "rollup": "^3.29.5",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "^5.3.3",
    "tslib": "^2.6.2"
  }
}
